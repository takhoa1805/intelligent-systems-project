generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(80)
  slug               String               @unique @db.VarChar(80)
  dataSource         String               @default("signal_shop") @map("data_source") @db.VarChar(30)
  sourceCategoryName String?              @map("source_category_name") @db.VarChar(80)
  products           Product[]
  translation        CategoryTranslation?

  @@unique([dataSource, sourceCategoryName], map: "uq_categories_source_name")
  @@map("categories")
}

model CategoryTranslation {
  id             Int      @id @default(autoincrement())
  categoryId     Int      @unique @map("category_id")
  portugueseName String   @unique @map("portuguese_name") @db.VarChar(80)
  englishName    String   @map("english_name") @db.VarChar(80)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("category_translations")
}

// Persistent anonymous identity. Imported names equal customer_unique_id.
model Customer {
  id        String             @id @db.VarChar(32)
  name      String             @db.VarChar(120)
  snapshots CustomerSnapshot[]
  orders    Order[]

  @@map("customers")
}

// Olist customer_id is specific to an order; location belongs to that snapshot.
model CustomerSnapshot {
  id            String   @id @db.VarChar(32)
  customerId    String   @map("customer_id") @db.VarChar(32)
  zipCodePrefix String   @map("zip_code_prefix") @db.VarChar(5)
  city          String   @db.VarChar(120)
  state         String   @db.VarChar(2)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order         Order?

  @@index([customerId], map: "idx_customer_snapshots_customer")
  @@index([zipCodePrefix], map: "idx_customer_snapshots_zip")
  @@map("customer_snapshots")
}

model Seller {
  id            String      @id @db.VarChar(32)
  zipCodePrefix String      @map("zip_code_prefix") @db.VarChar(5)
  city          String      @db.VarChar(120)
  state         String      @db.VarChar(2)
  orderItems    OrderItem[]

  @@index([zipCodePrefix], map: "idx_sellers_zip")
  @@map("sellers")
}

// Observations, not one row per ZIP. Source row preserves even exact duplicates.
model Geolocation {
  id            BigInt @id @default(autoincrement())
  sourceRow     Int    @unique @map("source_row")
  zipCodePrefix String @map("zip_code_prefix") @db.VarChar(5)
  latitude      Float  @db.DoublePrecision
  longitude     Float  @db.DoublePrecision
  city          String @db.VarChar(120)
  state         String @db.VarChar(2)

  @@index([zipCodePrefix], map: "idx_geolocations_zip")
  @@map("geolocations")
}

model Product {
  id                      Int         @id @default(autoincrement())
  categoryId              Int         @map("category_id")
  name                    String      @db.VarChar(160)
  slug                    String      @unique @db.VarChar(180)
  description             String
  price                   Decimal     @db.Decimal(12, 2)
  currency                String      @default("USD") @db.VarChar(3)
  stock                   Int         @default(0)
  imageUrl                String?     @map("image_url")
  accent                  String      @default("#FF6B35") @db.VarChar(20)
  featured                Boolean     @default(false)
  active                  Boolean     @default(true)
  rating                  Decimal     @default(4.5) @db.Decimal(2, 1)
  tags                    String[]    @default([])
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  dataSource              String      @default("signal_shop") @map("data_source") @db.VarChar(30)
  sourceId                String?     @map("source_id") @db.VarChar(32)
  // Marks name, description, price, stock, rating, tags and accent as synthetic.
  syntheticCatalog        Boolean     @default(false) @map("synthetic_catalog")
  catalogSeed             String?     @map("catalog_seed") @db.VarChar(80)
  sourceNameLength        Int?        @map("source_name_length")
  sourceDescriptionLength Int?        @map("source_description_length")
  photosQuantity          Int?        @map("photos_quantity")
  weightG                 Int?        @map("weight_g")
  lengthCm                Int?        @map("length_cm")
  heightCm                Int?        @map("height_cm")
  widthCm                 Int?        @map("width_cm")
  category                Category    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems              OrderItem[]
  userEvents              UserEvent[]

  @@unique([dataSource, sourceId], map: "uq_products_source_id")
  @@index([categoryId], map: "idx_products_category")
  @@index([active, updatedAt(sort: Desc)], map: "idx_products_active_updated_at")
  @@map("products")
}

model Order {
  id                  BigInt            @id @default(autoincrement())
  orderNumber         String            @unique @default(dbgenerated("('SS-'::text || upper(SUBSTRING(md5((random())::text), 1, 6)))")) @map("order_number")
  customerName        String            @map("customer_name") @db.VarChar(120)
  customerEmail       String?           @map("customer_email") @db.VarChar(160)
  subtotal            Decimal?          @db.Decimal(12, 2)
  total               Decimal?          @db.Decimal(12, 2)
  status              String            @default("paid") @db.VarChar(30)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  dataSource          String            @default("signal_shop") @map("data_source") @db.VarChar(30)
  sourceId            String?           @map("source_id") @db.VarChar(32)
  customerId          String?           @map("customer_id") @db.VarChar(32)
  customerSnapshotId  String?           @unique @map("customer_snapshot_id") @db.VarChar(32)
  currency            String            @default("USD") @db.VarChar(3)
  shippingTotal       Decimal?          @map("shipping_total") @db.Decimal(12, 2)
  paymentTotal        Decimal?          @map("payment_total") @db.Decimal(12, 2)
  // Raw source wall-clock dates retain the CSV's lack of timezone information.
  purchasedAt         DateTime?         @map("purchased_at") @db.Timestamp(6)
  approvedAt          DateTime?         @map("approved_at") @db.Timestamp(6)
  deliveredCarrierAt  DateTime?         @map("delivered_carrier_at") @db.Timestamp(6)
  deliveredCustomerAt DateTime?         @map("delivered_customer_at") @db.Timestamp(6)
  estimatedDeliveryAt DateTime?         @map("estimated_delivery_at") @db.Timestamp(6)
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerSnapshot    CustomerSnapshot? @relation(fields: [customerSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items               OrderItem[]
  payments            OrderPayment[]
  reviews             OrderReview[]

  @@unique([dataSource, sourceId], map: "uq_orders_source_id")
  @@index([createdAt], map: "idx_orders_created_at")
  @@index([customerId], map: "idx_orders_customer")
  @@index([dataSource, status, purchasedAt], map: "idx_orders_source_status_purchase")
  @@map("orders")
}

model OrderItem {
  id                 BigInt    @id @default(autoincrement())
  orderId            BigInt    @map("order_id")
  productId          Int?      @map("product_id")
  productName        String    @map("product_name") @db.VarChar(160)
  quantity           Int
  unitPrice          Decimal   @map("unit_price") @db.Decimal(12, 2)
  sourceItemSequence Int?      @map("source_item_sequence")
  sellerId           String?   @map("seller_id") @db.VarChar(32)
  freightValue       Decimal?  @map("freight_value") @db.Decimal(12, 2)
  shippingLimitAt    DateTime? @map("shipping_limit_at") @db.Timestamp(6)
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product            Product?  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller             Seller?   @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderId, sourceItemSequence], map: "uq_order_items_source_sequence")
  @@index([productId], map: "idx_order_items_product")
  @@index([sellerId], map: "idx_order_items_seller")
  @@map("order_items")
}

model OrderPayment {
  id           BigInt  @id @default(autoincrement())
  orderId      BigInt  @map("order_id")
  sequence     Int
  type         String  @db.VarChar(30)
  installments Int
  value        Decimal @db.Decimal(12, 2)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, sequence], map: "uq_order_payments_sequence")
  @@map("order_payments")
}

model OrderReview {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt   @map("order_id")
  sourceReviewId  String   @map("source_review_id") @db.VarChar(32)
  score           Int
  commentTitle    String?  @map("comment_title")
  commentMessage  String?  @map("comment_message")
  reviewCreatedAt DateTime @map("review_created_at") @db.Timestamp(6)
  answeredAt      DateTime @map("answered_at") @db.Timestamp(6)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, sourceReviewId], map: "uq_order_reviews_source_id")
  @@index([sourceReviewId], map: "idx_order_reviews_source_id")
  @@map("order_reviews")
}

model UserEvent {
  id        BigInt   @id @default(autoincrement())
  sessionId String   @map("session_id") @db.VarChar(100)
  eventType String   @map("event_type") @db.VarChar(40)
  productId Int?     @map("product_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sessionId, eventType], map: "idx_events_session_type")
  @@index([createdAt], map: "idx_events_created_at")
  @@map("user_events")
}
